<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="rocket_bg">#10111A</color>
    <color name="ic_launcher_background">#272733</color>

    <!-- Dark platform theme: dialogs and the settings panel match the scene; bars are transparent. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rocket_bg</item>
        <item name="android:colorAccent">#A487EC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
